#!/usr/bin/env node
// tslint:disable

const path = require("path");
const pkg = require("../package.json");
const fs = require("fs");
const optimistUsageLength = 98;
const yargs = require("yargs");
const version = pkg.version;
const { PeerServer } = require("../dist/src");
const { createClientLog } = require("./client-log");
// const tools = require('../config/winston.mjs');

const winston = require("winston");
const winstonDaily = require("winston-daily-rotate-file");

const logDir = process.env.PEERJS_LOG_DIR || '/usr/local/bnids/logs';  // 로그 파일 위치(시험 때만 바꾼다)
const { combine, timestamp, printf } = winston.format;

// Define log format
const logFormat = printf(info => {
  return `${info.timestamp} ${info.level}: ${info.message}`;
});


/*
 * Log Level
 * error: 0, warn: 1, info: 2, http: 3, verbose: 4, debug: 5, silly: 6
 */
const logger = winston.createLogger({
  format: combine(
    timestamp({
      format: 'YYYY-MM-DD HH:mm:ss',
    }),
    logFormat,
  ),
  transports: [
    new winstonDaily({
      level: 'info',
      name: 'info',
      filename: `peerjs-server-%DATE%.log`,
      datePattern: 'YYYYMMDD',
      dirname: logDir,
      maxFiles: 30,  // 30일치 로그 파일 저장
      zippedArchive: true, 
    }),
  ],
});

// 터미널에서 직접 띄울 때만 콘솔에도 찍는다.
// pm2·systemd 아래에서는 stdout 이 회전 없는 pm2 로그·저널로 그대로 복제돼 수 GB 씩 쌓였다(2026-10-13).
// 파일 로그(위, 30일 보관)가 정본이다. 꼭 콘솔이 필요하면 PEERJS_CONSOLE=1.
if (process.stdout.isTTY || process.env.PEERJS_CONSOLE === '1') {
  logger.add(new winston.transports.Console({
    format: winston.format.combine(
      winston.format.colorize(),  // 색깔 넣어서 출력
      winston.format.simple(),  // `${info.level}: ${info.message} JSON.stringify({ ...rest })` 포맷으로 출력
    )
  }));
}

const opts = yargs
  .usage("Usage: $0")
  .wrap(Math.min(optimistUsageLength, yargs.terminalWidth()))
  .options({
    expire_timeout: {
      demandOption: false,
      alias: "t",
      describe: "timeout (milliseconds)",
      default: 5000
    },
    concurrent_limit: {
      demandOption: false,
      alias: "c",
      describe: "concurrent limit",
      default: 5000
    },
    alive_timeout: {
      demandOption: false,
      describe: "broken connection check timeout (milliseconds)",
      default: 60000
    },
    check_interval: {
      demandOption: false,
      describe: "broken connection check interval (milliseconds)",
      // upstream 은 300ms 다. 끊김 판정이 alive_timeout(60초) 단위라 5초면 충분하고 깨어남이 1/16 로 준다
      default: 5000
    },
    key: {
      demandOption: false,
      alias: "k",
      describe: "connection key",
      default: "peerjs"
    },
    // TLS 는 nginx 가 끝낸다. peerjs 는 루프백 평문으로만 듣는다 — 인증서 만료가 peerjs 재시작을 막지 않게.
    // 꼭 TLS 로 직접 받아야 하면 --sslkey/--sslcert 를 둘 다 준다.
    sslkey: {
      demandOption: false,
      describe: "path to SSL key"
    },
    sslcert: {
      demandOption: false,
      describe: "path to SSL certificate"
    },
    host: {
      demandOption: false,
      alias: "H",
      describe: "host",
      default: "127.0.0.1"
    },
    port: {
      demandOption: true,
      alias: "p",
      describe: "port"
    },
    path: {
      demandOption: false,
      describe: "custom path",
      default: "/"
    },
    allow_discovery: {
      demandOption: false,
      describe: "allow discovery of peers"
    },
    proxied: {
      demandOption: false,
      describe: "Set true if PeerServer stays behind a reverse proxy",
      default: false
    }
  })
  .boolean("allow_discovery")
  .argv;

// 삼키지 않고 죽는다. 포트 충돌·치명 오류 뒤에 듣지도 않는 프로세스가 남으면 systemd 가 되살리지 못한다.
const die = (e) => {
  logger.error("Fatal: " + (e && e.stack || e));
  setTimeout(() => process.exit(1), 300);
};
process.on("uncaughtException", die);
process.on("unhandledRejection", die);

if (opts.sslkey || opts.sslcert) {
  if (opts.sslkey && opts.sslcert) {
    opts.ssl = {
      key: fs.readFileSync(path.resolve(opts.sslkey)),
      cert: fs.readFileSync(path.resolve(opts.sslcert))
    };

    logger.info(`ssl: key ${opts.sslkey}, cert ${opts.sslcert}`);

    delete opts.sslkey;
    delete opts.sslcert;
  } else {
    logger.error("Warning: PeerServer will not run because either " +
      "the key or the certificate has not been provided.");
    process.exit(1);
  }
}

const userPath = opts.path;
const server = PeerServer(opts, server => {
  const host = server.address().address;
  const port = server.address().port;

  logger.info(`Started PeerServer on ${host}, port: ${port}, path: ${userPath || "/"}, ${opts.ssl ? "https" : "http"} (v. ${version})`);

  const shutdownApp = () => {
    clientLog.flush(true);
    server.close(() => {
      logger.info('Http server closed.');
      process.exit(0);
    });
    // 열린 웹소켓이 남아 있으면 close 가 끝나지 않는다(systemd 정지 90초 대기). 3초 뒤 정리한다
    setTimeout(() => process.exit(0), 3000).unref();
  };

  process.on('SIGINT', shutdownApp);
  process.on('SIGTERM', shutdownApp);
});

// 같은 통로의 재접속 반복은 10분에 3번까지만 그대로, 나머지는 요약 한 줄로 남긴다
const clientLog = createClientLog(msg => logger.info(msg));
setInterval(() => clientLog.flush(), 60 * 1000).unref();

server.on("connection", client => {
  clientLog.event("connected", client.getId());
});

server.on("disconnect", client => {
  clientLog.event("disconnected", client.getId());
});
